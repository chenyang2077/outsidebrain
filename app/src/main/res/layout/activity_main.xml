<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 全屏黑色背景层（保持不变） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"/>

    <!-- 顶部容器（保持不变） -->
    <LinearLayout
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/menu_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_folder2"
            android:contentDescription="菜单按钮"
            android:background="@drawable/btn_click_bg"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/item_rounded_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginHorizontal="4dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:background="@null"
                android:singleLine="true"
                android:textSize="16sp"
                android:hint="Lv-1"
                android:textColor="#FFFFFF"
                android:inputType="text"
                android:imeOptions="actionSearch"/>

            <!-- 你原来的粘贴按钮占位（完全没动！） -->
            <FrameLayout
                android:id="@+id/paste_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"/>

            <!-- 新增：压缩按钮占位（和你粘贴格式完全一样！） -->
            <FrameLayout
                android:id="@+id/zip_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"/>

            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="2dp"
                android:text="搜索"
                android:backgroundTint="@color/gray"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/file_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="1dp"
        android:paddingBottom="2dp"
        android:layout_below="@id/top_container"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="添加文件或文件夹"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/gray"
        app:elevation="8dp"
        android:layout_alignBottom="@id/file_list"
        android:layout_alignEnd="@id/file_list"
        android:layout_alignParentEnd="false"/>

</RelativeLayout>