<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/top_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_alignParentTop="true">

    <!-- 左侧图标 -->
        <!-- 图标按钮：保留原图标样式，增加按钮交互特性 -->
        <ImageButton
            android:id="@+id/icon2_btn"
        android:layout_width="50dp"
        android:layout_height="48dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_folder2"
        android:background="@null"
        android:padding="0dp"
        android:contentDescription="返回/文件夹入口"
        android:clickable="true"
        android:focusable="true"
        android:backgroundTint="@android:color/transparent"
        app:backgroundTintMode="src_in"/>

    <!-- 搜索栏（包裹在top_container内） -->
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/item_rounded_bg"
        android:padding="4dp"
        android:layout_marginHorizontal="8dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="搜索文件夹/文件（名称或内容）"
            android:paddingHorizontal="16dp"
            android:background="@null"
            android:singleLine="true"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:layout_marginHorizontal="8dp"
            android:text="搜索"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:paddingVertical="4dp"
            android:paddingHorizontal="16dp"/>

    </LinearLayout>
</LinearLayout>

    <!-- 2. 文件列表：位于top_container下方（修复核心） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/file_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:paddingBottom="80dp"
    android:contentDescription="文件列表，显示当前文件夹下的文件夹和TXT文件"
    android:layout_below="@id/top_container"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="添加文件或文件夹"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/colorPrimary"
        app:elevation="8dp"
        android:layout_alignBottom="@id/file_list"
    android:layout_alignEnd="@id/file_list"
    android:layout_alignParentEnd="false"/>


    </RelativeLayout>
