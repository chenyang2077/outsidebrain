<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 全屏黑色背景层（保持不变） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"/>

    <!-- 顶部容器（修改：添加粘贴按钮容器） -->
    <LinearLayout
        android:id="@+id/top_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <!-- 将原按钮ID修改为新名称，用于弹出菜单 -->
        <ImageButton
            android:id="@+id/menu_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_folder2"
            android:contentDescription="菜单按钮"

            android:background="@drawable/btn_click_bg"

        android:clickable="true"
        android:focusable="true"/>

        <LinearLayout
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/item_rounded_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginHorizontal="4dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingHorizontal="12dp"
                android:background="@null"
                android:singleLine="true"
                android:textSize="16sp"
                android:hint="Lv-1"
                android:textColor="#FFFFFF"
                android:inputType="text"
            android:imeOptions="actionSearch"
            />
            <FrameLayout
                android:id="@+id/paste_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"/>
            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="2dp"
                android:text="搜索"
                android:backgroundTint="@color/gray"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <!-- 新增：粘贴按钮容器（搜索按钮右侧） -->


        </LinearLayout>
    </LinearLayout>

    <!-- 原有文件列表（保持不变） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/file_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="1dp"
        android:paddingBottom="2dp"
        android:layout_below="@id/top_container"/>

    <!-- 原有悬浮按钮（保持不变） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="添加文件或文件夹"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/gray"
        app:elevation="8dp"
        android:layout_alignBottom="@id/file_list"
        android:layout_alignEnd="@id/file_list"
        android:layout_alignParentEnd="false"/>

</RelativeLayout>