<?xml version="1.0" encoding="utf-8"?>
<!-- 新增外层 ScrollView -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"> <!-- 这个属性很重要，确保子视图能填满 ScrollView 的可见区域 -->

    <!-- 你原来的 LinearLayout，宽度改为 match_parent，高度改为 wrap_content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/editorBgColor"
        android:orientation="vertical"
        android:padding="3dp">

        <!-- 标题编辑区（带边框）- 无修改 -->
        <EditText
            android:id="@+id/et_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@drawable/editor_border"
            android:hint=":"
            app:hintTextColor="#AAAAAA"
            android:textColor="@color/editorTextColor"
            android:textSize="20sp"
            android:textStyle="bold"
            android:singleLine="true"
        android:inputType="text|textNoSuggestions"
        android:imeOptions="actionDone"
        android:layout_marginBottom="4dp"/>

        <!-- 内容编辑区（带边框）- 核心修改在这里 -->
        <EditText
            android:id="@+id/et_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
        android:background="@drawable/editor_border2"
        android:padding="5dp"
        android:hint="请输入文件内容..."
        app:hintTextColor="#888888"
        android:textColor="@color/editorTextColor"
        android:textSize="16sp"
        android:gravity="top|left"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:lineSpacingExtra="3dp"/>

    </LinearLayout>

</ScrollView>