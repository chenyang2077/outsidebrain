<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editorBgColor"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- 标题栏 → 固定置顶，不会滑动 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/editor_border"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="10dp"
        android:paddingEnd="0dp">

        <EditText
            android:id="@+id/et_file_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="0dp"
            android:background="@null"
            android:hint=":"
            app:hintTextColor="#AAAAAA"
            android:textColor="@color/editorTextColor"
            android:textSize="20sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="actionDone"/>

        <LinearLayout
            android:id="@+id/btn_container"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
        android:orientation="vertical"
        android:layout_marginStart="6dp"
        android:gravity="top"
        android:visibility="gone">

        <!-- 回撤 固定位置占位 -->
        <FrameLayout
            android:layout_width="30dp"
        android:layout_height="25dp"
        android:gravity="center">
        <TextView
            android:id="@+id/btn_undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↩️"
            android:textSize="20sp"
            android:textColor="#757575"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

    <!-- 重做 固定位置占位 -->
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="25dp"
        android:gravity="center">
        <TextView
            android:id="@+id/btn_redo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↪️"
            android:textSize="20sp"
            android:textColor="#757575"
            android:clickable="true"
            android:focusable="true"/>
    </FrameLayout>

</LinearLayout>

    </LinearLayout>

    <!-- 内容区 → 只有这里可以滑动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <EditText
            android:id="@+id/et_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/editor_border2"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:paddingRight="5dp"
            android:paddingLeft="9dp"
            android:hint="请输入文件内容..."
            app:hintTextColor="#888888"
            android:textColor="@color/editorTextColor"
            android:textSize="16sp"
            android:gravity="top|left"
            android:inputType="textMultiLine|textNoSuggestions"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:lineSpacingExtra="3dp"/>

    </ScrollView>

</LinearLayout>