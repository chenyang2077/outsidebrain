<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editorBgColor"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- 标题编辑区（带边框） -->
    <EditText
        android:id="@+id/et_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@drawable/editor_border"
        android:hint=":"
        app:hintTextColor="#AAAAAA"
        android:textColor="@color/editorTextColor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:inputType="textCapWords|textNoSuggestions"
        android:imeOptions="actionNext"
        android:layout_marginBottom="4dp"/>

    <!-- 内容编辑区（带边框） -->
    <EditText
        android:id="@+id/et_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/editor_border"
        android:padding="5dp"
        android:hint="请输入文件内容..."
        app:hintTextColor="#888888"
        android:textColor="@color/editorTextColor"
        android:textSize="16sp"
        android:gravity="top|left"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:lineSpacingExtra="3dp"/>

</LinearLayout>
