<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editorBgColor"
    android:orientation="vertical">

    <!-- 标题编辑区（用户可手动输入，也可自动生成） -->
    <EditText
        android:id="@+id/et_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@null"
        android:hint="自动生成标题（内容前15字）"
        app:hintTextColor="#AAAAAA"
        android:textColor="@color/editorTextColor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:inputType="textCapWords|textNoSuggestions"
        android:imeOptions="actionNext"/>

    <!-- 内容编辑区（ID必须为et_content，与代码绑定） -->
    <EditText
        android:id="@+id/et_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:padding="16dp"
        android:hint="请输入文件内容..."
        app:hintTextColor="#888888"
        android:textColor="@color/editorTextColor"
        android:textSize="16sp"
        android:gravity="top|left"
        android:inputType="textMultiLine|textNoSuggestions"
        android:scrollbars="vertical"
        android:lineSpacingExtra="3dp"/>

</LinearLayout>