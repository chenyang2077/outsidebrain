<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础应用主题 -->
    <style name="Theme.OutsideBrain" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item> <!-- 隐藏系统默认标题栏 -->
        <item name="windowNoTitle">true</item>    <!-- 不显示标题 -->
    </style>

    <style name="Theme.OutsideBrain.NoActionBar" parent="Theme.OutsideBrain">
        <item name="windowActionBar">false</item> <!-- 隐藏系统默认标题栏 -->
        <item name="windowNoTitle">true</item>    <!-- 不显示标题 -->
        <!-- 可选：设置编辑页面的状态栏颜色，与深灰背景协调 -->
        <item name="android:statusBarColor">@color/editorBgColor</item>
    </style>



    <!-- 自定义PopupMenu样式 -->
    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/white</item>
        <item name="android:itemBackground">@drawable/menu_item_bg</item>
        <item name="android:itemTextAppearance">@style/MenuTextStyle</item>
    </style>

    <style name="MenuTextStyle" parent="TextAppearance.AppCompat.Menu">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
