<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础应用主题 -->
    <style name="Theme.OutsideBrain" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item> <!-- 隐藏系统默认标题栏 -->
        <item name="windowNoTitle">true</item>    <!-- 不显示标题 -->
    </style>

    <style name="Theme.OutsideBrain.NoActionBar" parent="Theme.OutsideBrain">
        <item name="windowActionBar">false</item> <!-- 隐藏系统默认标题栏 -->
        <item name="windowNoTitle">true</item>    <!-- 不显示标题 -->
        <!-- 可选：设置编辑页面的状态栏颜色，与深灰背景协调 -->
        <item name="android:statusBarColor">@color/editorBgColor</item>
    </style>


    <!-- 图片查看器全屏主题 -->
    <style name="Theme.OutsideBrain.NoActionBar.Fullscreen" parent="Theme.OutsideBrain.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="MenuTextStyle" parent="TextAppearance.AppCompat.Menu">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 确保FileOptionsDialogStyle引用该标题样式 -->
    <style name="FileOptionsDialogStyle" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_transparent_bg</item>
        <item name="android:titleTextAppearance">@style/DialogTitleStyle</item> <!-- 关联标题样式 -->
        <item name="android:padding">0dp</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>

    <!-- 在styles.xml中更新标题样式 -->
    <style name="DialogTitleStyle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/zipColor</item> <!-- 设置为zipColor -->
        <item name="android:padding">4dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <!-- 最小化标题样式 -->
    <style name="MinimalDialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/zipColor</item> <!-- 设置为zipColor -->
        <item name="android:padding">4dp</item>
        <item name="android:layout_margin">0dp</item>
    </style>



    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textSize">16sp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
    </style>


</resources>
