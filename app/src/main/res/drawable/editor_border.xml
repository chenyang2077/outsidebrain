<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 上层内容区域（与背景色一致，用于覆盖不需要的边框） -->
    <item>
        <shape>
            <solid android:color="@color/editorBgColor" />
        </shape>
    </item>

    <!-- 上边框 -->
    <item android:top="0dp">
        <shape>
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- 下边框 -->
    <item android:bottom="0dp">
        <shape>
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- 内容区域内边距（避免内容与边框重叠） -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0.4dp"
        android:bottom="0.4dp">
        <shape>
            <solid android:color="@color/editorBgColor" />
        </shape>
    </item>
</layer-list>
